{
  "name": "city-humanities-travel",
  "version": "1.0.0",
  "private": true,
  "description": "城市人文旅行 · 目的地展示 / 留言 / 预订意向（React SPA + Express + JSON 文件持久化）",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "start": "npm --workspace backend run start",
    "seed": "npm --workspace backend run seed",
    "test:backend": "npm --workspace backend run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
