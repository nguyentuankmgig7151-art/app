# 社区网站后端环境变量样例
# 复制为 server/.env 后按需修改；.env 禁止提交（已被 .gitignore 忽略）。

# 后端监听端口（默认 3001）
PORT=3001

# JWT 签名密钥（必填，禁止硬编码到代码；生产环境请使用足够长的随机串）
JWT_SECRET=change-me-to-a-long-random-secret

# JWT 有效期（默认 7d）
JWT_EXPIRES_IN=7d

# SQLite 数据库文件路径（默认 server/data/community.db）
DB_PATH=./data/community.db

# 允许跨域的前端来源（默认 http://localhost:5173）
CORS_ORIGIN=http://localhost:5173
